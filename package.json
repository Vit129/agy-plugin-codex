{
  "name": "@vit129/agy-plugin-codex",
  "version": "1.5.1",
  "description": "Codex plugin for the Antigravity agy companion.",
  "type": "module",
  "private": true,
  "files": [
    ".agents/plugins/marketplace.json",
    "plugins/agy",
    "LICENSE",
    "NOTICE",
    "README.md",
    "version.json"
  ],
  "scripts": {
    "start": "npm run preview",
    "preview": "npm run build",
    "build": "npm run check && npm test && npm pack --dry-run",
    "release": "npm run build && bash scripts/release.sh",
    "check": "node --check plugins/agy/scripts/agy-companion.mjs && node --check plugins/agy/scripts/lib/git-update-check.mjs && node --check plugins/agy/scripts/session-lifecycle-hook.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "license": "Apache-2.0"
}
